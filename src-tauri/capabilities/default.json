{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for CogNote",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$TEMP/*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$TEMP/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/*" }]
    },
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-mkdir",
    "dialog:default"
  ]
}